# ================================================================
# ÇİLEK DERGİSİ — SUPABASE ÇEVRESEL DEĞİŞKENLERİ (ENVIRONMENT VARIABLES)
# ================================================================

# Supabase Proje Bilgileri
# Supabase Dashboard > Settings > API bölümünden kopyalayın
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Kullanıcı E-posta Adresi
# Bu e-posta ile giriş yapan kullanıcı doğrudan /admin paneline erişebilir
VITE_ADMIN_EMAIL=admin@cilekdergisi.com

# PDF İndirmek İçin Kullanıcı Girişi Zorunlu mu? (true / false)
VITE_PDF_REQUIRE_LOGIN=true

# ================================================================
# CLOUDFLARE R2 STORAGE (S3 UYUMLU DEPOLAMA)
# Cloudflare Dashboard > R2 bölümünden temin edin
# ================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

